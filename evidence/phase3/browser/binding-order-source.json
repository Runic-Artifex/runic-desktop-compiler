{
  "source": "<script lang=\"ts\">\nlet text=$state('');let before=$state('');let locked=$state(false);let readonly=$state(false);let show=$state(true);\nlet length=$derived(text.length);\nfunction clear(){text='';}\nfunction lock(){locked=!locked;}\nfunction readOnly(){readonly=!readonly;}\nfunction toggle(){show=!show;}\n</script>\n<main><h1 id=\"heading\">Native text editor</h1><input id=\"editor\" aria-label=\"Text\" type=\"text\" maxlength=\"256\" oninput={() => before = text} bind:value={text} disabled={locked} {readonly}/><p id=\"before\">{before}</p><p id=\"preview\">{text}</p><p id=\"count\">{length}</p><button id=\"clear\" disabled={text===''} onclick={clear}>Clear</button><button id=\"lock\" onclick={lock}>Lock</button><button id=\"readonly\" onclick={readOnly}>Read only</button><button id=\"toggle\" onclick={toggle}>Toggle details</button>{#if show}<p id=\"details\">Stable editor identity</p>{/if}</main>\n",
